# Local self-signed code-signing cert for desktop dev builds — never commit
apps/desktop/.local-cert/

# Repo-root tool caches (project-scoped equivalents are tracked under apps/*)
/.serena/
/.trunk/

# HackerRank sync — local secrets, never commit
scripts/hackerrank-sync/.hackerrank-cookies.json
scripts/hackerrank-sync/hackerrank-descriptions.json

# Research pipeline — working files, not committed
apps/camora/scripts/research/*.json
.gstack/
.playwright-mcp/
apps/camora/scripts/.diagvenv/

# CodeSignal sync — local session cookie, never commit
scripts/codesignal-sync/.codesignal-learn-cookies.json
# Any browser session cookie jar from sync scripts
scripts/**/.*-cookies.json

# understand-anything knowledge graph (generated)
.ua/

# Repo-root scratch that kept getting committed by accident: ad-hoc review
# screenshots, one-off audit dumps, and a stale duplicate of the DevOps topic
# file (the real one is apps/camora/src/data/capra/topics/devopsTopics.js).
# Scoped with a leading slash so only the repo ROOT is affected - topic
# diagrams under apps/camora/public/diagrams/ must keep being tracked.
/*.png
/*.jpg
/*.jpeg
/*.pdf
/devopsTopics.js
/last_audit.json
/prior_week.json
