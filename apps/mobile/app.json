{
  "expo": {
    "name": "Camora",
    "slug": "camora",
    "scheme": "camora",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1115"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.cariara.camora",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Camora records audio when you tap the record button on the Live tab so it can transcribe what's said and surface relevant material from your study library. Recording does not start automatically.",
        "UIBackgroundModes": ["audio"],
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserActivityTypes": ["NSUserActivityTypeBrowsingWeb"]
      },
      "associatedDomains": ["applinks:camora.cariara.com", "webcredentials:camora.cariara.com"]
    },
    "android": {
      "package": "com.cariara.camora",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1115"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "camora.cariara.com", "pathPrefix": "/mobile/auth" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_CONTACTS",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "Camora records audio when you tap the record button on the Live tab so it can transcribe what's said and surface relevant material from your study library. Recording does not start automatically."
        }
      ]
    ],
    "extra": {
      "lumoraApiUrl": "https://lumorab.cariara.com",
      "capraApiUrl": "https://caprab.cariara.com",
      "webAppUrl": "https://camora.cariara.com"
    }
  }
}
