{
  "expo": {
    "name": "Camora",
    "slug": "camora",
    "scheme": "camora",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1115"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.cariara.camora",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Camora records audio when you tap the record button on the Interview tab so it can transcribe the conversation and surface relevant context from your prep. Recording does not start automatically.",
        "UIBackgroundModes": ["audio"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cariara.camora",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1115"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_CONTACTS",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": "Camora records audio when you tap the record button on the Interview tab so it can transcribe the conversation and surface relevant context from your prep. Recording does not start automatically."
        }
      ]
    ],
    "extra": {
      "lumoraApiUrl": "https://lumorab.cariara.com",
      "capraApiUrl": "https://caprab.cariara.com",
      "webAppUrl": "https://camora.cariara.com"
    }
  }
}
