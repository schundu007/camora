{
  "cli": { "version": ">= 13.0.0", "appVersionSource": "remote" },
  "build": {
    "base": {
      "node": "20.18.0",
      "env": {
        "EXPO_PUBLIC_LUMORA_API_URL": "https://lumorab.cariara.com",
        "EXPO_PUBLIC_CAPRA_API_URL": "https://caprab.cariara.com",
        "EXPO_PUBLIC_WEB_APP_URL": "https://camora.cariara.com"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "ios": { "simulator": false },
      "android": { "buildType": "apk" }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true,
      "ios": { "buildConfiguration": "Release" },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./store/play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
