    {
      "type": "text",
      "id": "cb-states-lbl",
      "x": 56.0,
      "y": 448,
      "width": 532.8,
      "height": 112,
      "angle": 0,
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
