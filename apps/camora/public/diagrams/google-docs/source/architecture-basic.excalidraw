    {
      "id": "ot-explain-text",
      "type": "text",
      "x": 452,
      "y": 304,
      "width": 365,
      "height": 224,
      "text": "User A: {op:\"insert\",pos:5,text:\"hello\",\n  userId:123, revision:42}\nUser B: {op:\"insert\",pos:3,text:\"world\",\n  userId:456, revision:42}\n\nOT transforms B's pos=3 against A's op:\nResult: B inserts at pos=3, A at pos=10\n(positions adjusted, no data lost)",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
