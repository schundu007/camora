    {
      "id": "evidence-text",
      "type": "text",
      "x": 44,
      "y": 358,
      "width": 412,
      "height": 308,
      "text": "CREATE TABLE messages (\n  channel_id  UUID,\n  timestamp   TIMEUUID,\n  sender_id   UUID,\n  content     TEXT,\n  media_url   TEXT,\n  PRIMARY KEY (channel_id, timestamp)\n) WITH CLUSTERING ORDER BY (timestamp DESC);\n\n-- Query: SELECT * FROM messages\n--        WHERE channel_id = ? LIMIT 50;",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "angle": 0
    },
