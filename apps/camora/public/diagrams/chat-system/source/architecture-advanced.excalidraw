    },
    {
      "id": "scale-box",
      "type": "rectangle",
      "x": 500,
      "y": 348,
      "width": 400,
      "height": 130,
      "strokeColor": "#b45309",
      "backgroundColor": "#fef3c7",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "angle": 0
    },
    {
      "id": "scale-text",
      "type": "text",
      "x": 514,
      "y": 358,
      "width": 529,
      "height": 280,
      "text": "Kafka fan-out: all WS gateways in channel subscribe\n→ each gateway delivers to its connected clients\n\nPresence: Redis key per user, TTL 60s, heartbeat every 30s\n\nConnection routing: Zookeeper stores which gateway\nserves each userId — message service looks up target\n\nMedia: client uploads directly to S3 presigned URL,\nsends CDN URL as message content (never through WS)",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#b45309",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "angle": 0
    }
