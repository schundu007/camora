    {
      "id": "schema-text",
      "type": "text",
      "x": 772,
      "y": 292,
      "width": 356,
      "height": 100,
      "text": "1. File change detected (inotify/FSEvents)\n2. Split into 4MB blocks, SHA-256 each\n3. POST /chunks/check → get missing hashes\n4. Upload only missing blocks to S3\n5. Commit metadata: PUT /files/{path}\n   { version, chunks: [hash1, hash2...] }\n6. Other devices notified via long poll",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "angle": 0
    }
