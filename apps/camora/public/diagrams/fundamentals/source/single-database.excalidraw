    {
      "id": "problems-text",
      "type": "text",
      "x": 80.0,
      "y": 360,
      "width": 512.0,
      "height": 140,
      "text": "Single point of failure — DB crash = total outage\nWrite bottleneck — all writes serialize on one machine\nLimited read capacity — no replicas to distribute reads\nBackup causes I/O contention during peak hours\nStorage limited to one machine's disk",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#7c2d12",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "roughness": 0,
      "opacity": 100
    },
