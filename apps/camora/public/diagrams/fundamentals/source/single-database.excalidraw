    {
      "id": "problems-box",
      "type": "rectangle",
      "x": 80,
      "y": 320,
      "width": 580,
      "height": 160,
      "strokeColor": "#c2410c",
      "backgroundColor": "#fed7aa",
      "fillStyle": "solid",
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "problems-title",
      "type": "text",
      "x": 80,
      "y": 330,
      "width": 580,
      "height": 24,
      "text": "Problems at Scale",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "strokeColor": "#c2410c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "problems-text",
      "type": "text",
      "x": 100,
      "y": 360,
      "width": 540,
      "height": 110,
      "text": "Single point of failure — DB crash = total outage\nWrite bottleneck — all writes serialize on one machine\nLimited read capacity — no replicas to distribute reads\nBackup causes I/O contention during peak hours\nStorage limited to one machine's disk",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#7c2d12",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "evidence-box",
      "type": "rectangle",
      "x": 700,
      "y": 120,
      "width": 380,
      "height": 100,
      "strokeColor": "#22c55e",
      "backgroundColor": "#1e293b",
      "fillStyle": "solid",
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "evidence-text",
      "type": "text",
      "x": 716,
      "y": 132,
      "width": 348,
      "height": 76,
      "text": "READ:   SELECT * FROM users WHERE id=1\n  → hits primary DB, returns row\nWRITE:  INSERT INTO orders VALUES (...)\n  → acquires row lock on primary",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "when-title",
      "type": "text",
      "x": 700,
      "y": 240,
      "width": 380,
      "height": 24,
      "text": "Use When",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "strokeColor": "#1e40af",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "when-text",
      "type": "text",
      "x": 700,
      "y": 268,
      "width": 380,
      "height": 70,
      "text": "< 10k users, low write volume\nPrototype / MVP stage\nStrict ACID requirements\nSimple operational overhead needed",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "roughness": 0,
      "opacity": 100
