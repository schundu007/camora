    },
    {
      "id": "problems-text",
      "type": "text",
      "x": 100,
      "y": 360,
      "width": 540,
      "height": 120,
      "text": "Single point of failure — DB crash = total outage\nWrite bottleneck — all writes serialize on one machine\nLimited read capacity — no replicas to distribute reads\nBackup causes I/O contention during peak hours\nStorage limited to one machine's disk",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#7c2d12",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "evidence-box",
      "type": "rectangle",
      "x": 688,
      "y": 99,
      "width": 404,
      "height": 142,
      "strokeColor": "#22c55e",
      "backgroundColor": "#1e293b",
      "fillStyle": "solid",
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "evidence-text",
      "type": "text",
      "x": 716,
      "y": 132,
      "width": 356,
      "height": 98,
      "text": "READ:   SELECT * FROM users WHERE id=1\n  → hits primary DB, returns row\nWRITE:  INSERT INTO orders VALUES (...)\n  → acquires row lock on primary",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "roughness": 0,
      "opacity": 100
    },
    {
