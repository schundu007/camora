    {
      "id": "evidence-text",
      "type": "text",
      "x": 54.4,
      "y": 412,
      "width": 531.2,
      "height": 140,
      "text": "GET    /users         → 200 OK  [ list of users ]\nPOST   /users         → 201 Created  { id, name, email }\nGET    /users/{id}    → 200 OK  { id, name } | 404 Not Found\nPUT    /users/{id}    → 200 OK  { updated } | 400 Bad Request\nDELETE /users/{id}    → 204 No Content | 500 Internal Error",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "notes-box",
      "type": "text",
      "x": 624.0,
      "y": 400,
      "width": 336.0,
      "height": 168,
      "text": "REST Constraints:\n- Stateless (no server-side session)\n- Uniform interface (HTTP verbs)\n- Resource-based URLs (/nouns)\n- Idempotent: GET, PUT, DELETE\n- Non-idempotent: POST",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "roughness": 0,
      "opacity": 100
    }
