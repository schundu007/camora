      "x": 62.4,
      "y": 444,
      "width": 579.2,
      "height": 84,
      "text": "user_id=500000  → hash(500000) % 3 = 2  → Shard 2\nuser_id=1500000 → hash(1500000) % 3 = 0 → Shard 0\nCross-shard JOIN avoided by denormalizing or routing at app layer",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
