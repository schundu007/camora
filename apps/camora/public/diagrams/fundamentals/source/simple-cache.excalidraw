      "x": 78,
      "y": 434,
      "width": 704,
      "height": 72,
      "text": "HIT:  GET user:123  → \"{ id:123, name:'Alice' }\"  (< 1ms)\nMISS: GET user:456  → (nil)\n      SELECT * FROM users WHERE id=456  → row\n      SET user:456 '{ id:456, ... }' EX 300  → OK  (next request: HIT)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
