    },
    {
      "type": "text",
      "id": "evidence-uber-basic-text",
      "x": 60,
      "y": 455,
      "width": 1060,
      "height": 231,
      "angle": 0,
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "seed": 5027,
      "version": 1,
      "versionNonce": 5027,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": [],
      "link": null,
      "locked": false,
      "text": "Driver GPS stream (every 4s):\n  {driverId: \"d-8821\", lat: 37.7749, lng: -122.4194, timestamp: 1704128400}\n  -> Location Service -> Redis GEOADD drivers:city_sf -122.4194 37.7749 d-8821\n\nRide request: POST /trips {riderId:\"r-4512\", pickup:{lat:37.7752, lng:-122.4180}}\n  -> Trip Service -> Matching Engine:\n     geohash(37.7752, -122.4180) = \"9q8yy\" (precision 5 = ~4.9km cell)\n     Redis GEOSEARCH drivers:city_sf FROMMEMBER pickup_loc BYRADIUS 2 km\n     -> [\"d-8821\" (0.3km), \"d-9944\" (1.1km), \"d-3301\" (1.7km)]\n     -> assign closest available driver d-8821\n  -> Trips DB INSERT trip (id, rider_id, driver_id, status=MATCHING, pickup_lat, pickup_lng)",
      "originalText": "Driver GPS stream (every 4s):\n  {driverId: \"d-8821\", lat: 37.7749, lng: -122.4194, timestamp: 1704128400}\n  -> Location Service -> Redis GEOADD drivers:city_sf -122.4194 37.7749 d-8821\n\nRide request: POST /trips {riderId:\"r-4512\", pickup:{lat:37.7752, lng:-122.4180}}\n  -> Trip Service -> Matching Engine:\n     geohash(37.7752, -122.4180) = \"9q8yy\" (precision 5 = ~4.9km cell)\n     Redis GEOSEARCH drivers:city_sf FROMMEMBER pickup_loc BYRADIUS 2 km\n     -> [\"d-8821\" (0.3km), \"d-9944\" (1.1km), \"d-3301\" (1.7km)]\n     -> assign closest available driver d-8821\n  -> Trips DB INSERT trip (id, rider_id, driver_id, status=MATCHING, pickup_lat, pickup_lng)",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
