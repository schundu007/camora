      "angle": 0
    },
    {
      "id": "indexflow-box",
      "type": "rectangle",
      "x": 480,
      "y": 360,
      "width": 410,
      "height": 110,
      "strokeColor": "#b45309",
      "backgroundColor": "#fef3c7",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "angle": 0
    },
    {
      "id": "indexflow-text",
      "type": "text",
      "x": 492,
      "y": 370,
      "width": 484,
      "height": 168,
      "text": "1. Crawl: fetch raw HTML, extract links\n2. Parse: extract title, body, anchor text\n3. Tokenize: split on whitespace/punct\n4. Normalize: lowercase, stem (\"running\" → \"run\")\n5. Stop words: remove \"the\", \"is\", \"at\"\n6. Index: term → [(docId, pos[], tf)] sorted by score",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#b45309",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "angle": 0
    }
