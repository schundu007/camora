    {
      "id": "evidence-text",
      "type": "text",
      "x": 52,
      "y": 370,
      "width": 493,
      "height": 196,
      "text": "\"database\": [\n  {docId: 42, pos: [5, 78], tf: 0.12, pagerank: 0.85},\n  {docId: 100, pos: [12], tf: 0.08, pagerank: 0.62}\n]\n\nScore = TF * log(N/df) * PageRank\nQuery: tokenize → stem → lookup → merge → rank",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "angle": 0
