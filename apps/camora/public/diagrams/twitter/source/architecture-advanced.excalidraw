    {
      "id": "evidence-text",
      "type": "text",
      "x": 44,
      "y": 408,
      "width": 502,
      "height": 168,
      "text": "# Regular user timeline (fanout on write)\ntimeline:user123  → [tweetId9, tweetId8, ..., tweetId1]\n\n# Celebrity cache (no fan-out)\nceleb:tweets:elonmusk → sorted set (score=timestamp)\n\n# Follower threshold check\nGET follower_count:userId  → \"10500\" (celebrity!)",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "angle": 0
    },
