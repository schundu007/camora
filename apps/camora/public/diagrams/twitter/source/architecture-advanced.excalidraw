    },
    {
      "id": "tradeoff-text",
      "type": "text",
      "x": 494,
      "y": 408,
      "width": 629,
      "height": 147,
      "text": "Pros: Eliminates celebrity write amplification\n       Regular users: O(1) read (just LRANGE)\n       Celebrities: fewer total writes\n\nCons: Read path more complex (must merge 2 sources)\n       Slight latency increase for reads (celebrity fetch)\n       Threshold boundary (9.9K vs 10K followers) can be inconsistent",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#b45309",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "angle": 0
    }
