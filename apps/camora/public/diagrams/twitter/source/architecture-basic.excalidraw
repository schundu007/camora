    {
      "id": "limitation-text",
      "type": "text",
      "x": 464,
      "y": 318,
      "width": 547,
      "height": 147,
      "text": "Celebrity Problem: @elonmusk has 100M followers\n→ ONE tweet triggers 100M Redis LPUSH writes!\n→ Timeline service is overwhelmed for seconds/minutes\n→ Followers see delayed or missing tweets\n\nWasted Storage: 10M inactive users still get timeline writes\nSolution needed: Hybrid Fanout (Advanced)",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#dc2626",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "angle": 0
    }
