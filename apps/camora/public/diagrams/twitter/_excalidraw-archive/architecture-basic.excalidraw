    {
      "id": "limitation-text",
      "type": "text",
      "x": 979,
      "y": 318,
      "width": 547,
      "height": 196,
      "text": "Celebrity Problem: @elonmusk has 100M followers\n\u2192 ONE tweet triggers 100M Redis LPUSH writes!\n\u2192 Timeline service is overwhelmed for seconds/minutes\n\u2192 Followers see delayed or missing tweets\n\nWasted Storage: 10M inactive users still get timeline writes\nSolution needed: Hybrid Fanout (Advanced)",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#dc2626",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "angle": 0
    }
