    },
    {
      "id": "gh",
      "label": "GitHub Actions",
      "type": "internet"
    },
    {
      "id": "runner",
      "label": "Bench Runner\nself-hosted, labeled",
      "type": "compute",
      "cluster": "lab"
    },
    {
      "id": "lease",
      "label": "Exclusive Lease\none job per board",
      "type": "function",
      "cluster": "lab"
    },
    {
      "id": "gpu",
      "label": "GPU Under Test\nreal MI300X",
      "type": "compute",
      "cluster": "lab"
    },
    {
      "id": "bmc",
      "label": "BMC / PDU\nout-of-band power",
      "type": "firewall",
      "cluster": "lab"
    },
    {
      "id": "serial",
      "label": "Serial Console\ncapture",
