    { "from": "writer", "to": "vectors", "label": "store", "kind": "control" },
    { "from": "writer", "to": "ann", "label": "index", "kind": "control" },
    { "from": "gw", "to": "query_svc", "kind": "main" },
    { "from": "query_svc", "to": "cache", "label": "lookup", "kind": "main" },
    { "from": "cache", "to": "ann", "label": "cache miss", "kind": "main" },
    { "from": "ann", "to": "meta", "label": "filter", "kind": "main" },
    { "from": "meta", "to": "vectors", "label": "fetch", "kind": "main" }
