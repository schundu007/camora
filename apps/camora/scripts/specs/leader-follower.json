{
  "title": "Leader-Follower — Replication & Failover",
  "direction": "LR",
  "clusters": [
    { "id": "primary", "label": "Primary" },
    { "id": "replicas", "label": "Replicas" },
    { "id": "control", "label": "Failover" }
  ],
  "nodes": [
    { "id": "client", "label": "Clients", "type": "client" },
    { "id": "router", "label": "Query Router\n(R/W split)", "type": "lb" },
