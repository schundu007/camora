    { "id": "wal", "label": "WAL\nLog Shipping", "type": "stream", "cluster": "primary" },
    { "id": "sync", "label": "Sync Replica\n(hot standby)", "type": "db", "cluster": "replicas" },
    { "id": "async", "label": "Async Read\nReplica", "type": "db", "cluster": "replicas" },
    { "id": "failover", "label": "Failover\nController", "type": "monitor", "cluster": "control" }
  ],
  "edges": [
