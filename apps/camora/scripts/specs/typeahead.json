    { "id": "cache", "label": "Prefix Cache\n(top-K per prefix)", "type": "cache", "cluster": "edge" },
    { "id": "trie", "label": "Trie Shards\n(prefix → top-K)", "type": "nosql", "cluster": "index" },
    { "id": "logs", "label": "Query Log\nStream", "type": "stream", "cluster": "build" },
