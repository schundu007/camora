    { "from": "fanout", "to": "outbox", "label": "per member", "kind": "control" },
    { "from": "clients", "to": "receipts", "label": "ack", "kind": "control" },
    { "from": "clients", "to": "media_svc", "label": "upload", "kind": "main" },
    { "from": "media_svc", "to": "blob", "kind": "main" },
    { "from": "blob", "to": "cdn", "label": "serve", "kind": "control" }
