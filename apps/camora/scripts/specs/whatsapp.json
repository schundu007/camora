{
  "title": "WhatsApp — E2E Messaging & Delivery",
  "direction": "LR",
  "clusters": [
    { "id": "edge", "label": "Connection Layer" },
    { "id": "core", "label": "Messaging Core" },
    { "id": "media", "label": "Media" }
  ],
  "nodes": [
    { "id": "clients", "label": "Clients\n(Signal E2E)", "type": "mobile" },
    { "id": "gw", "label": "Connection\nGateway", "type": "apigw", "cluster": "edge" },
    { "id": "msg_svc", "label": "Message\nService", "type": "compute", "cluster": "core" },
    { "id": "outbox", "label": "Offline\nQueue", "type": "queue", "cluster": "core" },
    { "id": "fanout", "label": "Group\nFan-out", "type": "function", "cluster": "core" },
    { "id": "msg_db", "label": "Message Store\n(cipher blobs)", "type": "nosql", "cluster": "core" },
    { "id": "receipts", "label": "Delivery\nReceipts", "type": "eventbus", "cluster": "core" },
    { "id": "media_svc", "label": "Media\nUpload Svc", "type": "compute", "cluster": "media" },
    { "id": "blob", "label": "Media\nBlob Store", "type": "storage", "cluster": "media" },
