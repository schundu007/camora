    { "id": "conn", "label": "Connection\nRegistry", "type": "cache", "cluster": "gw" },
    { "id": "pubsub", "label": "Pub/Sub\nFan-out", "type": "eventbus", "cluster": "backend" },
    { "id": "app", "label": "App Service\n(publishers)", "type": "compute", "cluster": "backend" },
