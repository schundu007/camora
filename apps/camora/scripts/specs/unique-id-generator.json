    { "id": "clock", "label": "NTP Clock\n(skew guard)", "type": "monitor", "cluster": "gen" },
    { "id": "seq", "label": "Sequence\nCounter", "type": "cache", "cluster": "gen" },
    { "id": "coordsvc", "label": "Worker-ID\nRegistry", "type": "compute", "cluster": "coord" },
