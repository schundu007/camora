{
  "title": "Unique ID Generator — Snowflake at 1M+ IDs/sec",
  "direction": "LR",
  "clusters": [
    { "id": "edge", "label": "Clients" },
    { "id": "gen", "label": "ID Generation Nodes" },
    { "id": "coord", "label": "Coordination" }
  ],
  "nodes": [
    { "id": "services", "label": "App\nServices", "type": "client" },
