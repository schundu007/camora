    { "id": "mailstore", "label": "Mail Store\n(threads · labels)", "type": "db", "cluster": "store" },
    { "id": "blob", "label": "Attachment\nStore", "type": "storage", "cluster": "store" },
    { "id": "index", "label": "Search Index\n(inverted)", "type": "search", "cluster": "store" },
    { "id": "push", "label": "FCM Push", "type": "eventbus", "cluster": "deliver" },
