{
  "title": "Multi-Cloud Architecture — Active Region + DR",
  "direction": "LR",
  "clusters": [
    { "id": "aws", "label": "AWS  ·  Primary" },
    { "id": "azure", "label": "Azure  ·  DR" },
    { "id": "gcp", "label": "GCP  ·  Backup" }
  ],
  "nodes": [
    { "id": "users", "label": "Users", "type": "users" },
    { "id": "dns", "label": "Global Traffic\nManager", "type": "dns" },
    { "id": "aws_lb", "label": "ALB", "type": "lb", "cluster": "aws" },
    { "id": "aws_app", "label": "EKS", "type": "compute", "cluster": "aws" },
    { "id": "aws_db", "label": "RDS\n(primary)", "type": "db", "cluster": "aws" },
    { "id": "link", "label": "Cloud\nInterconnect", "type": "internet" },
    { "id": "az_app", "label": "AKS", "type": "compute", "cluster": "azure" },
    { "id": "az_db", "label": "Azure SQL\n(replica)", "type": "db", "cluster": "azure" },
    { "id": "gcp_store", "label": "GCS\n(DR backup)", "type": "storage", "cluster": "gcp" }
