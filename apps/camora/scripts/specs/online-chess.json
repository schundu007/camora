    { "id": "state", "label": "Game State\n+ Clocks", "type": "cache", "cluster": "game" },
    { "id": "match", "label": "Matchmaking\n(ELO)", "type": "function", "cluster": "services" },
    { "id": "profile", "label": "Player / Rating\nDB", "type": "db", "cluster": "services" },
