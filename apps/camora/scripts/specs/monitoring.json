    { "id": "agg", "label": "Aggregation\n/ Recording", "type": "function", "cluster": "core" },
    { "id": "alert", "label": "Alert\nManager", "type": "eventbus", "cluster": "core" },
    { "id": "dash", "label": "Grafana\nDashboards", "type": "monitor", "cluster": "consume" },
