{
  "title": "Twitter — Timeline Ranking ML Pipeline",
  "subtitle": "Candidate generation and real-time scoring",
  "theme": "dark",
  "flow": [
    {
      "lane": "main",
      "nodes": [
        {
          "id": "sources",
