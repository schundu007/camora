  "panels": [
    {
      "kind": "code",
      "title": "Adaptive Logic (ABR)",
      "body": "if buffer_health < 5s:\n  switch to lower resolution\n\nif throughput > 15 Mbps AND\n   buffer_health > 15s:\n  switch to 4K resolution"
    },
    {
