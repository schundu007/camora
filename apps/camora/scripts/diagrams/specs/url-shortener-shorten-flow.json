        },
        {
          "id": "db",
          "label": "NoSQL Store\nSave mapping",
          "kind": "datastore"
        },
        {
          "id": "redis",
          "label": "Redis\nPre-warm cache",
          "kind": "cache"
        }
      ]
    }
  ],
  "panels": [
    {
      "kind": "code",
      "title": "Base62 Encoding",
