{
  "title": "URL Shortener — Shorten URL Flow",
  "subtitle": "Write path: from long URL to short code",
  "theme": "dark",
  "flow": [
    {
      "lane": "main",
      "nodes": [
        {
          "id": "user",
          "label": "User\nPOST /shorten",
