# Server
PORT=3009
NODE_ENV=production

# Database (shared with Lumora)
DATABASE_URL=postgresql://user:pass@host:5432/camora

# JWT (MUST match Lumora backend)
# JWT_SECRET is canonical. JWT_SECRET_KEY is the previous name and is still read
# as a fallback for backward compatibility — set JWT_SECRET going forward.
JWT_SECRET=your-shared-jwt-secret

# Google OAuth
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REDIRECT_URI=https://camora.cariara.com/api/auth/google/callback

# AI
# ascend-backend answers on GEMINI, never Anthropic — see "LLM Provider
# Separation" in CLAUDE.md before changing a model call. Do NOT put an
# ANTHROPIC_API_KEY here: the only Anthropic branch in this service
# (routes/ask.js) is gated behind a hard-coded ANTHROPIC_ENABLED = false.
# Most call sites read GOOGLE_AI_API_KEY first, then GEMINI_API_KEY.
GOOGLE_AI_API_KEY=xxx
GEMINI_API_KEY=xxx
OPENAI_API_KEY=sk-xxx

# Stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_QUARTERLY_PRO=price_xxx
STRIPE_PRICE_DESKTOP=price_xxx
STRIPE_PRICE_ADDON=price_xxx

# Redis
REDIS_URL=redis://localhost:6379

# Frontend URL (for OAuth redirects)
FRONTEND_URL=https://camora.cariara.com

# Admin
ADMIN_SECRET=your-admin-secret
CODE_RUNNER_URL=http://localhost:4000
CODE_RUNNER_API_KEY=replace-with-a-random-internal-secret
