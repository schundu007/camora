{
  "manifest_version": 3,
  "name": "Camora Problem Bridge",
  "version": "1.0.0",
  "description": "Lets camora.cariara.com read the coding-problem tab you have open, so the problem loads without copy-pasting the URL.",
  "permissions": [],
  "host_permissions": [
    "https://leetcode.com/problems/*",
    "https://*.leetcode.com/problems/*",
    "https://leetcode.cn/problems/*",
    "https://*.leetcode.cn/problems/*",
    "https://*.hackerrank.com/*",
    "https://*.coderpad.io/*",
    "https://*.codesignal.com/*",
    "https://*.glider.ai/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://camora.cariara.com/*",
        "http://localhost:3000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {}
}
