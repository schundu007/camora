{
  "name": "@camora/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Camora Desktop — native shell for camora.cariara.com with system-audio loopback, screen capture, and document export",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:dmg": "rm -rf build && electron-builder --mac --arm64 && bash ./post-build.sh arm64",
    "build:dmg-x64": "electron-builder --mac --x64 && bash ./post-build.sh x64",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:win-arm64": "electron-builder --win --arm64 -c.win.artifactName=Camora-${version}-Setup-arm64.${ext}",
    "build:win-zip": "electron-builder --win --x64 -c.win.target.0.target=zip -c.win.artifactName=Camora-${version}-win-x64.zip"
  },
  "dependencies": {
    "docx": "^9.0.3",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "41.5.0",
    "electron-builder": "26.8.1"
  },
  "build": {
    "appId": "com.cariara.camora",
    "productName": "Camora",
    "artifactName": "Camora-${version}-${arch}.${ext}",
    "protocols": [
      {
        "name": "Camora",
        "schemes": [
          "camora"
        ]
      }
    ],
    "afterPack": "build-hooks/after-pack.js",
    "afterAllArtifactBuild": "build-hooks/after-all-artifact-build.js",
    "directories": {
      "output": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "browserProbe.js",
      "stealth-dom.js",
      "icon.icns",
      "icon.png",
      "node_modules/docx/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/universalify/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/argparse/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/semver/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/debug/**/*",
      "node_modules/ms/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Camora needs microphone access to transcribe your voice during sessions.",
        "NSCameraUsageDescription": "Camora may use your camera for video interview practice.",
        "NSScreenCaptureUsageDescription": "Camora records audio from your meeting window so it can be transcribed and answered.",
        "NSAudioCaptureUsageDescription": "Camora captures system audio output so audio can be transcribed during live sessions."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icon.png",
      "artifactName": "Camora-1.0.0-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "dmg": {
      "title": "Camora",
      "iconSize": 100,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "schundu007",
        "repo": "camora",
        "releaseType": "release"
      }
    ],
    "buildVersion": "1.0.1407"
  }
}
