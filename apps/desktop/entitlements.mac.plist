<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Required for HackerRank auto-detect: lets Camora send Apple Events
         (AppleScript) to Google Chrome to read the active tab URL and
         inject JS for DOM scraping. Without this, all osascript calls to
         Chrome are silently blocked by macOS TCC regardless of the
         Automation permission dialog. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- Screen capture for desktopCapturer + setDisplayMediaRequestHandler -->
    <key>com.apple.security.scripting-targets</key>
    <dict>
        <key>com.apple.systemevents</key>
        <array>
            <string>com.apple.systemevents.screensharing</string>
        </array>
    </dict>
</dict>
</plist>
