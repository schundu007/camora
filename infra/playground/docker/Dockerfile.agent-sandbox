FROM nestybox/ubuntu-jammy-systemd-docker:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget git vim nano jq tmux htop \
    python3 python3-pip python3-venv \
    build-essential ca-certificates gnupg \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Node.js 20 LTS via NodeSource (apt ships Node 12 which is too old for claude-code)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ARG TTYD_VERSION=1.7.7
RUN curl -fsSL "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VERSION}/ttyd.x86_64" \
    -o /usr/local/bin/ttyd && chmod +x /usr/local/bin/ttyd

RUN npm install -g @anthropic-ai/claude-code@latest

RUN pip3 install --no-cache-dir google-generativeai

RUN npm install -g openai

RUN useradd -m -s /bin/bash camora && \
    echo 'camora ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/camora && \
    chmod 0440 /etc/sudoers.d/camora

RUN printf '\033[1;36m\n  Camora AI Agent Sandbox\033[0m\n\n  Pre-installed tools:\n    claude        \033[0;90m# Claude Code (Anthropic)\033[0m\n    python3/pip   \033[0;90m# Python + google-generativeai\033[0m\n    node/npm      \033[0;90m# Node.js + openai SDK\033[0m\n    git curl wget vim nano jq tmux\n\n\033[0;33m  Set your API keys:\033[0m\n    export ANTHROPIC_API_KEY=sk-ant-...\n    export OPENAI_API_KEY=sk-...\n    export GOOGLE_API_KEY=AIza...\n\n\033[0;90m  Happy building!\033[0m\n\n' > /etc/camora-motd && \
    echo 'cat /etc/camora-motd' >> /home/camora/.bashrc && \
    chown camora:camora /home/camora/.bashrc

ENV TERM=xterm-256color
EXPOSE 7681
COPY start-ubuntu.sh /start.sh
RUN chmod +x /start.sh
ENTRYPOINT ["/start.sh"]
