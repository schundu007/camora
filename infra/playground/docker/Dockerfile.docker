FROM nestybox/ubuntu-jammy-systemd-docker:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget git vim nano jq tmux \
    docker-compose-plugin \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ARG TTYD_VERSION=1.7.7
RUN curl -fsSL "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VERSION}/ttyd.x86_64" \
    -o /usr/local/bin/ttyd && chmod +x /usr/local/bin/ttyd

COPY start-docker.sh /start.sh
RUN chmod +x /start.sh

RUN printf '\033[1;36m\n  Camora Docker Playground\033[0m\n\n  Pre-installed tools:\n    docker · docker compose · git · curl · wget\n    vim · nano · jq · tmux\n\n\033[0;90m  Happy hacking! Type a command to get started.\033[0m\n\n' > /etc/camora-motd && \
    echo 'cat /etc/camora-motd' >> /root/.bashrc

ENV TERM=xterm-256color
EXPOSE 7681
ENTRYPOINT ["/start.sh"]
