FROM nestybox/ubuntu-jammy-systemd-docker:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget git vim nano jq tmux htop netcat-openbsd \
    dnsutils iputils-ping traceroute tcpdump \
    python3 python3-pip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ARG TTYD_VERSION=1.7.7
RUN curl -fsSL "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VERSION}/ttyd.x86_64" \
    -o /usr/local/bin/ttyd && chmod +x /usr/local/bin/ttyd

COPY start-ubuntu.sh /start.sh
RUN chmod +x /start.sh

RUN printf '\033[1;32m\n  Camora Ubuntu Playground\033[0m\n\n  Pre-installed tools:\n    bash · python3 · pip · git · curl · wget\n    vim · nano · jq · tmux · htop · netcat\n    ping · nslookup · traceroute · tcpdump\n\n\033[0;90m  Happy hacking! Type a command to get started.\033[0m\n\n' > /etc/camora-motd && \
    echo 'cat /etc/camora-motd' >> /root/.bashrc

ENV TERM=xterm-256color
EXPOSE 7681
ENTRYPOINT ["/start.sh"]
