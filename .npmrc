# Hoist transitive deps so Expo's monorepo layout works correctly.
# Required by apps/mobile (Expo SDK 53+ resolves expo-modules-core and other
# native deps via the flat node_modules layout, not pnpm's symlinked store).
# Verified safe for apps/camora (Vite handles either layout) and the Express
# backends (no resolver assumptions).
node-linker=hoisted
